  updatedAt      DateTime @updatedAt
  coverImage     Media?   @relation(fields: [coverImageId], references: [id], onDelete: SetNull)
  items          FeaturedCollectionItem[]

  @@index([published, updatedAt])
  @@index([coverImageId])
}

