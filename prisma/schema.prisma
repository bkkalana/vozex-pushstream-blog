enum ResourcePricing {
  FREE
  FREEMIUM
  PAID
  CONTACT
}
enum ResourceStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}
enum CollectionItemType {
  POST
  AI_TOOL
  REVIEW
  RESOURCE
}
model ContentSeries {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  posts       ContentSeriesPost[]

  @@index([updatedAt])
}

model ContentSeriesPost {
  seriesId  String
  postId    String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  series    ContentSeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  post      Post          @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([seriesId, postId])
  @@unique([postId])
  @@index([seriesId, sortOrder])
}

model FeaturedCollection {
  id             String   @id @default(cuid())
  title          String
  slug           String   @unique
  description    String?  @db.Text
  coverImageId   String?
  seoTitle       String?
  seoDescription String?  @db.Text
