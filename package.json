    "audit:performance": "node scripts/performance-audit.mjs",
    "audit:accessibility": "node scripts/accessibility-audit.mjs",
    "release:check": "node scripts/release-check.mjs",
    "smoke:production": "node scripts/smoke-production.mjs",
    "deploy:production": "bash scripts/deploy-production.sh",
    "jobs:work": "tsx scripts/job-worker.ts",
    "audit:integration": "node scripts/final-integration-audit.mjs",
    "db:bootstrap-clean": "bash scripts/bootstrap-clean-database.sh",
    "release:final": "bash scripts/final-release-gate.sh",
    "audit:seo": "node scripts/seo-regression-audit.mjs",
    "audit:visual-parity": "node scripts/frontend-visual-parity-audit.mjs",
    "preflight:production": "bash scripts/production-preflight.sh",
    "backup:production": "bash scripts/backup-release-state.sh",
    "rollback:application": "bash scripts/rollback-application.sh",
