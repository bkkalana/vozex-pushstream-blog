    "audit:prisma-client": "node scripts/prisma-client-freshness-audit.mjs"
  },
  "dependencies": {
    "@prisma/client": "^7.0.0",
    "lucide-react": "^0.544.0",
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sonner": "^2.0.7",
    "zod": "^4.1.11",
    "@prisma/adapter-mariadb": "^7.0.0",
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.2.3",
