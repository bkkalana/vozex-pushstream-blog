# PushStream production environment template. Never commit the real .env.
NODE_ENV=production
SITE_URL=https://pushstream.online
DATABASE_URL=mysql://pushstream:change-me@127.0.0.1:3306/pushstream

# Generate: openssl rand -base64 48
SESSION_SECRET=replace-with-at-least-32-random-characters
SESSION_TTL_HOURS=12
REMEMBER_SESSION_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

# Seed bootstrap account. Replace before first seed.
SUPER_ADMIN_NAME=PushStream Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password-at-least-12-chars

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=PushStream <no-reply@pushstream.online>

UPLOAD_DIR=./public/uploads
UPLOAD_MAX_BYTES=12582912
STORAGE_PROVIDER=local
MEDIA_KEEP_ORIGINAL=true
MEDIA_PREVENT_DELETE_IN_USE=true
NEXT_PUBLIC_SITE_NAME=PushStream

# Generate independently from SESSION_SECRET.
CRON_SECRET=replace-with-a-long-random-secret

# Optional smoke-test override used after PM2 starts.
SMOKE_BASE_URL=http://127.0.0.1:8021

# Optional AI-assisted editorial workspace (server-only credentials)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# Optional future/local OpenAI-compatible JSON endpoint. Must return {"text":"..."}.
LOCAL_AI_ENDPOINT=
LOCAL_AI_API_KEY=

# Phase 26 email provider abstraction
EMAIL_PROVIDER=smtp
BREVO_API_KEY=
RESEND_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
CONVERTKIT_API_KEY=

# Phase 27: TOTP secrets are encrypted with a key derived from SESSION_SECRET.
# Keep SESSION_SECRET stable and backed up; rotating it requires a 2FA migration/reenrollment plan.

# Phase 30 notes
# Webhook signing secrets are entered per endpoint in Admin and encrypted at rest.
# Keep SESSION_SECRET stable; rotating it requires a webhook/2FA secret rotation plan.
