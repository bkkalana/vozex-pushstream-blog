# PushStream production environment template
# Copy this file to .env on the server and replace every placeholder with real values.

NODE_ENV=production
SITE_URL=https://pushstream.online

DATABASE_URL=mysql://DB_USER:DB_PASSWORD@127.0.0.1:3306/pushstream

SESSION_SECRET=replace-with-a-random-secret-at-least-32-characters
SESSION_TTL_HOURS=12
REMEMBER_SESSION_DAYS=30
PASSWORD_RESET_TTL_MINUTES=30

SUPER_ADMIN_NAME=PushStream Administrator
SUPER_ADMIN_EMAIL=admin@example.com
SUPER_ADMIN_PASSWORD=replace-with-a-strong-password

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
EMAIL_PROVIDER=smtp

BREVO_API_KEY=
RESEND_API_KEY=
MAILCHIMP_API_KEY=
MAILCHIMP_SERVER_PREFIX=
CONVERTKIT_API_KEY=

UPLOAD_DIR=./public/uploads
UPLOAD_MAX_BYTES=12582912

CRON_SECRET=replace-with-a-random-cron-secret-at-least-32-characters

OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LOCAL_AI_ENDPOINT=
LOCAL_AI_API_KEY=
